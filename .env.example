# Copier ce fichier en `.env` : cp .env.example .env
# Ne jamais committer `.env` (déjà ignoré par git).

# ── Base de données (SQLite) ────────────────────────────────────────────────
# Le chemin est relatif au dossier prisma/ (fichier prisma/dev.db).
DATABASE_URL="file:./dev.db"

# ── Authentification ────────────────────────────────────────────────────────
# OBLIGATOIRE en production : sans valeur, un secret de développement public est utilisé.
JWT_SECRET="change-me-min-32-chars-random-string-000"

# ── LLM de factorisation / élicitation ──────────────────────────────────────
# auto | local | anthropic
#   auto      : Anthropic si ANTHROPIC_API_KEY est renseignée, sinon serveur local
#   local     : serveur Ollama uniquement (données jamais envoyées à un tiers)
#   anthropic : API Anthropic uniquement
LLM_PROVIDER=auto

# Serveur local (Ollama)
LLM_LOCAL_ENDPOINT=http://localhost:11434
LLM_LOCAL_MODEL=ministral:latest
# LLM_LOCAL_NUM_CTX=8192
LLM_LOCAL_TIMEOUT_MS=180000

# API Anthropic — uniquement pour des données NON sensibles
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# ── Knowledge Hub LLMOps ────────────────────────────────────────────────────
LLMOPS_BASE_URL=http://127.0.0.1:8000
# Jeton de service Archinex (doit porter les scopes kb:review, kb:delegate)
LLMOPS_AUTH_TOKEN=
LLMOPS_ENGAGEMENT=default-project
# Hôtes LLMOps distants autorisés nommément, séparés par des virgules (ex. un hôte Cloud Run).
# Sans cela, les hôtes hors réseau local sont refusés (règle air-gap).
LLMOPS_ALLOWED_HOSTS=
# Délai uniforme en ms qui prime sur les délais par opération
# LLMOPS_TIMEOUT_MS=

# ── Embeddings de similarité (calculés par Archinex, jamais par LLMOps) ─────
# toy-bow = encodeur de test sans valeur sémantique (refusé en production sauf ALLOW_TOY_EMBEDDINGS=1)
EMBEDDING_MODEL=toy-bow
# Serveur Ollama calculant les vecteurs pour tout autre modèle (ex. bge-m3)
# EMBEDDING_OLLAMA_URL=http://localhost:11434
ALLOW_TOY_EMBEDDINGS=0

# ── Tests (optionnel) ───────────────────────────────────────────────────────
# Serveur LLMOps de contrat déjà démarré, pour les tests « live » (sinon ils sont ignorés)
# LLMOPS_LIVE_URL=http://127.0.0.1:8099
# LLMOPS_LIVE_TOKEN=contract-service-token
# Démarrer un conteneur LLMOps éphémère via Docker (testcontainers)
# TEST_CONTAINERS=1
# Mode mock en mémoire, à consentir explicitement
# USE_FAKE_LLMOPS=1
