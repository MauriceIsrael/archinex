{
  "name": "archinex",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "prepare": "svelte-kit sync || echo ''",
    "dev": "vite dev",
    "dev:host": "vite dev --host",
    "build": "vite build",
    "preview": "vite preview",
    "pretest": "prisma generate && svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "check:denylist": "node scripts/check-no-project-names.mjs",
    "db:push": "prisma db push",
    "db:reset": "prisma db push --force-reset --skip-generate && tsx prisma/seed-dev.ts",
    "db:generate": "prisma generate",
    "seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "test:e2e:api": "vitest run tests/e2e/regulatory-to-capitalization.test.ts",
    "test:e2e:browser": "playwright test",
    "demo:e2e": "cross-env DEMO_E2E=1 playwright test --project=chromium",
    "test:integration:closed-loop": "vitest run tests/integration/closed-loop-deliberation.test.ts",
    "test:integration:retraction": "vitest run tests/integration/causal-retraction-cascade.test.ts",
    "test:integration:debate": "vitest run tests/integration/expert-debate-maturation.test.ts",
    "verify": "node scripts/verify.mjs",
    "ollama:models": "node scripts/ollama-models.mjs",
    "eval:requirements": "tsx scripts/eval-requirements-audit.ts",
    "benchmark:run": "tsx scripts/benchmark-run.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@internationalized/date": "^3.12.1",
    "@lucide/svelte": "^1.14.0",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-auto": "^4.0.0",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.16.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/bcryptjs": "^2.4.6",
    "bits-ui": "^2.18.1",
    "cross-env": "^10.1.0",
    "lucide-svelte": "^1.0.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "svelte-i18n": "^4.0.1",
    "svelte-preprocess": "^6.0.3",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.2.4",
    "testcontainers": "^12.0.4",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^6.19.3",
    "@tailwindcss/vite": "^4.2.4",
    "@types/pdf-parse": "^1.1.5",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.9.0",
    "casbin": "^5.50.0",
    "casbin-prisma-adapter": "^1.12.0",
    "clsx": "^2.1.1",
    "echarts": "^6.0.0",
    "gridstack": "^12.6.0",
    "jose": "^6.2.3",
    "mermaid": "^12.0.0",
    "pdf-parse": "^2.4.5",
    "prisma": "^6.19.3",
    "tailwind-merge": "^3.5.0",
    "tsx": "^4.21.0",
    "zod": "^4.4.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
