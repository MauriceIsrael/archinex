{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://archinex.io/schemas/edp.schema.json",
  "title": "ExecutableDecisionPackage",
  "description": "Contrat formel d'un Paquet de Décision Exécutable (EDP) associant intension pure, liaisons ontologiques et oracles OPA/Rego.",
  "type": "object",
  "required": [
    "metadata",
    "decision_context",
    "refinement_contract",
    "verification_oracle",
    "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["id", "title", "status", "revision", "decision_ref"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^EDP-[A-Za-z0-9_.-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": ["draft", "proposed", "validated", "stale", "retracted"]
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "decision_ref": {
          "type": "object",
          "required": ["subjectId", "decisionId", "version"],
          "additionalProperties": false,
          "properties": {
            "subjectId": { "type": "string", "minLength": 1 },
            "decisionId": { "type": "string", "minLength": 1 },
            "version": {
              "oneOf": [
                { "type": "integer", "minimum": 1 },
                { "type": "string", "minLength": 1 }
              ]
            }
          }
        }
      }
    },
    "decision_context": {
      "type": "object",
      "required": ["problem", "decision", "tradeoffs", "ontology_bindings"],
      "additionalProperties": false,
      "properties": {
        "problem": { "type": "string", "minLength": 1 },
        "decision": { "type": "string", "minLength": 1 },
        "tradeoffs": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ]
        },
        "ontology_bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["urn", "revision"],
            "additionalProperties": false,
            "properties": {
              "urn": {
                "type": "string",
                "pattern": "^urn:[a-z0-9][a-z0-9-]{0,31}:[A-Za-z0-9()+,-.:=@;$_!*'%/?#]+$"
              },
              "revision": {
                "oneOf": [
                  { "type": "integer", "minimum": 1 },
                  { "type": "string", "minLength": 1 }
                ]
              }
            }
          }
        }
      }
    },
    "refinement_contract": {
      "type": "object",
      "required": ["expected_inputs"],
      "additionalProperties": false,
      "properties": {
        "expected_inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["source", "schema_version"],
            "additionalProperties": false,
            "properties": {
              "source": { "type": "string", "minLength": 1 },
              "path": { "type": "string" },
              "schema_version": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "verification_oracle": {
      "type": "object",
      "required": [
        "engine",
        "entrypoint",
        "policy_files",
        "self_test",
        "mutation_manifest"
      ],
      "additionalProperties": false,
      "properties": {
        "engine": {
          "type": "string",
          "enum": ["opa"]
        },
        "entrypoint": {
          "type": "string",
          "pattern": "^data\\.[a-zA-Z0-9_.]+$"
        },
        "policy_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["filename", "sha256"],
            "additionalProperties": false,
            "properties": {
              "filename": { "type": "string", "minLength": 1 },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "content": { "type": "string" }
            }
          }
        },
        "self_test": {
          "type": "object",
          "required": ["cases"],
          "additionalProperties": false,
          "properties": {
            "cases": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["name", "expected_verdict"],
                "additionalProperties": false,
                "properties": {
                  "name": { "type": "string", "minLength": 1 },
                  "description": { "type": "string" },
                  "expected_verdict": {
                    "type": "string",
                    "enum": ["compliant", "violated", "not_applicable", "insufficient_input"]
                  },
                  "expected_violations": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "input_mock": { "type": "object" }
                }
              }
            }
          }
        },
        "mutation_manifest": {
          "type": "object",
          "required": ["mutants"],
          "additionalProperties": false,
          "properties": {
            "mutants": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "description", "target_rule"],
                "additionalProperties": false,
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "description": { "type": "string" },
                  "target_rule": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["production_mode", "created_at"],
      "additionalProperties": false,
      "properties": {
        "production_mode": {
          "type": "string",
          "enum": [
            "human-authored",
            "llm-proposed-human-approved",
            "llm-derived"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "validator": {
          "type": "object",
          "required": ["id", "role", "timestamp"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "role": { "type": "string", "minLength": 1 },
            "timestamp": { "type": "string", "format": "date-time" }
          }
        }
      }
    }
  }
}

