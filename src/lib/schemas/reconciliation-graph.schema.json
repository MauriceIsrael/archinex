{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://archinex.io/schemas/reconciliation-graph.schema.json",
  "title": "ReconciliationGraphContract",
  "description": "Contrat formel de séparation Modèle (Hub / feuille d'ontologie) vs Instances (Projet / LLD ou Nautobot) pour le graphe de réconciliation multi-objets (Issue #414).",
  "definitions": {
    "classKey": {
      "type": "string",
      "enum": [
        "partner_organizations",
        "external_shadow_nodes",
        "internal_mediation_nodes",
        "ip_underlay_links",
        "ipsec_tunnels",
        "service_mediation_flows",
        "sla_and_monitoring_contracts"
      ]
    },
    "relationRule": {
      "type": "object",
      "required": ["from_class", "field", "target_classes"],
      "additionalProperties": false,
      "properties": {
        "from_class": { "$ref": "#/definitions/classKey" },
        "field": { "type": "string", "minLength": 1 },
        "target_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/classKey" }
        },
        "required": { "type": "boolean" },
        "is_array": { "type": "boolean" }
      }
    },
    "reconciliationModel": {
      "type": "object",
      "description": "Déclaration portée par la feuille d'ontologie dans `hydration_template.reconciliation_model` (aucun identifiant concret de projet).",
      "additionalProperties": false,
      "properties": {
        "required_classes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/classKey" }
        },
        "require_pivot": { "type": "boolean" },
        "standards_applied": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "required_relations": {
          "type": "array",
          "items": { "$ref": "#/definitions/relationRule" }
        }
      }
    },
    "reconciliationObject": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "reconciliationInstances": {
      "type": "object",
      "description": "Instances concrètes fournies par le projet (`lldOverrides.reconciliationInstances` ou pull Nautobot).",
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "pivot_tenant_id": { "type": "string" },
        "standards_applied": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "partner_organizations": {
          "type": "array",
          "items": { "$ref": "#/definitions/reconciliationObject" }
        },
        "external_shadow_nodes": {
          "type": "array",
          "items": {
            "allOf": [
              { "$ref": "#/definitions/reconciliationObject" },
              {
                "type": "object",
                "properties": {
                  "tenant_ref": { "type": "string", "minLength": 1 }
                }
              }
            ]
          }
        },
        "internal_mediation_nodes": {
          "type": "array",
          "items": {
            "allOf": [
              { "$ref": "#/definitions/reconciliationObject" },
              {
                "type": "object",
                "properties": {
                  "tenant_ref": { "type": "string", "minLength": 1 },
                  "peer_shadow_ref": { "type": "string", "minLength": 1 },
                  "upstream_secgw_ref": { "type": "string", "minLength": 1 },
                  "allowed_upstream_ref": { "type": "string", "minLength": 1 }
                }
              }
            ]
          }
        },
        "ip_underlay_links": {
          "type": "array",
          "items": {
            "allOf": [
              { "$ref": "#/definitions/reconciliationObject" },
              {
                "type": "object",
                "properties": {
                  "tenant_ref": { "type": "string", "minLength": 1 },
                  "endpoint_a": { "type": "string", "minLength": 1 },
                  "endpoint_z": { "type": "string", "minLength": 1 }
                }
              }
            ]
          }
        },
        "ipsec_tunnels": {
          "type": "array",
          "items": {
            "allOf": [
              { "$ref": "#/definitions/reconciliationObject" },
              {
                "type": "object",
                "properties": {
                  "tenant_ref": { "type": "string", "minLength": 1 },
                  "underlay_link_ref": { "type": "string", "minLength": 1 },
                  "termination_a": { "type": "string", "minLength": 1 },
                  "termination_z": { "type": "string", "minLength": 1 }
                }
              }
            ]
          }
        },
        "service_mediation_flows": {
          "type": "array",
          "items": {
            "allOf": [
              { "$ref": "#/definitions/reconciliationObject" },
              {
                "type": "object",
                "properties": {
                  "tenant_ref": { "type": "string", "minLength": 1 },
                  "source_shadow_ref": { "type": "string", "minLength": 1 },
                  "destination_core_ref": { "type": "string", "minLength": 1 },
                  "ipsec_tunnel_ref": { "type": "string", "minLength": 1 },
                  "mandatory_mediation_hops": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 }
                  }
                }
              }
            ]
          }
        },
        "sla_and_monitoring_contracts": {
          "type": "array",
          "items": {
            "allOf": [
              { "$ref": "#/definitions/reconciliationObject" },
              {
                "type": "object",
                "properties": {
                  "tenant_ref": { "type": "string", "minLength": 1 },
                  "covered_flow_ref": { "type": "string", "minLength": 1 },
                  "covered_tunnel_ref": { "type": "string", "minLength": 1 },
                  "monitored_targets": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 }
                  }
                }
              }
            ]
          }
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "reconciliation_model": { "$ref": "#/definitions/reconciliationModel" },
    "reconciliation_instances": { "$ref": "#/definitions/reconciliationInstances" }
  }
}
