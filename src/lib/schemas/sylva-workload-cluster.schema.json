{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sylva.org/schemas/v1alpha1/SylvaWorkloadCluster.json",
  "title": "SylvaWorkloadCluster",
  "description": "Validation Schema for Sylva Workload Cluster Custom Resource (workloadclusteroperator.sylva/v1alpha1)",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {
      "type": "string",
      "enum": [
        "workloadclusteroperator.sylva/v1alpha1",
        "workloadcluster.sylva.org/v1alpha1"
      ]
    },
    "kind": {
      "type": "string",
      "const": "SylvaWorkloadCluster"
    },
    "metadata": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "labels": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "spec": {
      "type": "object",
      "properties": {
        "sylvaUnitsReleasePresets": {
          "description": "List of SylvaUnitsReleasePreset resource names defining bundles of parameters (official CRD)",
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "infrastructure": {
          "description": "Underlying infrastructure provider for the cluster (metal3, openstack, vsphere, docker)",
          "type": "string",
          "enum": ["metal3", "openstack", "vsphere", "docker"]
        },
        "controlPlane": {
          "description": "Control plane configuration (rke2, kubeadm, ck8s)",
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "enum": ["rke2", "kubeadm", "ck8s"]
            },
            "replicas": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "k8sVersion": {
          "description": "Two-number Kubernetes version (e.g. 1.28)",
          "type": "string",
          "pattern": "^[1-9]+[0-9]*[.]([1-9]+[0-9]|0)+$"
        },
        "enabledUnits": {
          "description": "Map of unit names to boolean activation flags",
          "type": "object",
          "additionalProperties": { "type": "boolean" }
        },
        "clusterSettings": {
          "description": "Free-form JSON settings mapped to SylvaUnitsRelease.spec.values.cluster",
          "type": "object",
          "additionalProperties": true
        },
        "overridingValues": {
          "description": "Free-form JSON settings mapped to SylvaUnitsRelease.spec.values",
          "type": "object",
          "additionalProperties": true
        },
        "valuesFrom": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "ConfigMap",
                  "Secret",
                  "ExternalSecret",
                  "GitRepository",
                  "OCIRepository",
                  "SylvaUnitsFile"
                ]
              },
              "name": { "type": "string" },
              "valuesKey": { "type": "string" },
              "valuesPath": { "type": "string" },
              "targetPath": { "type": "string" },
              "context": { "type": "string" },
              "optional": { "type": "boolean" }
            }
          }
        },
        "capi_providers": {
          "type": "object",
          "properties": {
            "infra_provider": {
              "type": "string",
              "enum": ["capm3", "capd", "capo", "capv", "metal3"]
            },
            "bootstrap_provider": {
              "type": "string",
              "enum": ["cabpr", "cabpk", "kubeadm", "rke2"]
            }
          },
          "additionalProperties": true
        },
        "k8s_version": {
          "type": "string"
        },
        "os_image_selector": {
          "type": "object",
          "properties": {
            "os": { "type": "string" },
            "release": { "type": "string" },
            "hardened": { "type": "boolean" }
          },
          "additionalProperties": true
        },
        "units": {
          "type": "object",
          "properties": {
            "cilium": { "type": "object", "properties": { "enabled": { "type": "boolean" } } },
            "multus": { "type": "object", "properties": { "enabled": { "type": "boolean" } } },
            "sriov": { "type": "object", "properties": { "enabled": { "type": "boolean" } } },
            "sriov-resources": { "type": "object", "properties": { "enabled": { "type": "boolean" } } },
            "metallb": { "type": "object", "properties": { "enabled": { "type": "boolean" } } },
            "vault": { "type": "object", "properties": { "enabled": { "type": "boolean" } } },
            "kyverno": { "type": "object", "properties": { "enabled": { "type": "boolean" } } },
            "monitoring": { "type": "object", "properties": { "enabled": { "type": "boolean" } } }
          },
          "additionalProperties": true
        },
        "baremetal_hosts": {
          "type": "object",
          "additionalProperties": true
        },
        "machine_deployments": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
