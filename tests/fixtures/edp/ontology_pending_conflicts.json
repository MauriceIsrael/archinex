{
  "description": "ÉCARTS DE DOCTRINE NON TRANCHÉS entre l'ancienne ontologie d'Archinex et celle du Hub (LLMOps#199, docs/ONTOLOGY-MIGRATION-REPORT.md, section « conflits ») : valeurs qu'Archinex utilisait (paramètres de ses règles Rego pour oob et oam) et que le Hub n'a pas. Ce n'est PAS de la donnée de projet. À supprimer, entité par entité, dès que les experts ont tranché dans le Hub (Archinex#417). Le lot « règles d'oracle + projections » d'une feuille ne se mélange pas : l'écart REMPLACE celui du Hub (`$replace`) pour oob et oam, où le Hub déclare deux règles sans implémentation Rego dans Archinex (deny_shared_oob_network, deny_insecure_security_zone).",
  "entityPatches": {
    "urn:archinex:ontology:telecom:network:oob": {
      "governed_by_clauses": [
        "urn:archinex:kb:clause:telecom:oob_isolation"
      ],
      "keywords": [
        "redfish",
        "administration",
        "ipmi"
      ],
      "projections": {
        "$replace": {
          "required_status": "planned",
          "min_interfaces": 2
        }
      },
      "hydration_template": {
        "nautobot_interfaces": [
          {
            "name": "oob0",
            "type": "management",
            "ip": "192.0.2.10/24"
          },
          {
            "name": "eth0",
            "type": "data",
            "ip": "10.20.0.10/24"
          }
        ]
      },
      "oracle_rules": {
        "$replace": [
          "data.archinex.edp.multiaxis.deny_invalid_device_status",
          "data.archinex.edp.multiaxis.deny_insufficient_interfaces",
          "data.archinex.edp.multiaxis.deny_missing_oob_ip",
          "data.archinex.edp.multiaxis.deny_bmc_oob_drift"
        ]
      }
    },
    "urn:archinex:ontology:security:zone:oam": {
      "governed_by_clauses": [
        "urn:archinex:kb:clause:nis2:oam_strict_bastion"
      ],
      "keywords": [
        "exploitation",
        "proxy",
        "isolation",
        "zone",
        "sécurité",
        "admin"
      ],
      "projections": {
        "$replace": {
          "isolation_level": "strict",
          "proxy_required": true
        }
      },
      "hydration_template": {
        "security_zone": {
          "zone_id": "ZONE-OAM",
          "isolation_level": "strict",
          "proxy_required": true
        }
      },
      "oracle_rules": {
        "$replace": [
          "data.archinex.edp.multiaxis.deny_missing_oam_zone",
          "data.archinex.edp.multiaxis.deny_weak_oam_isolation",
          "data.archinex.edp.multiaxis.deny_unproxied_oam_access"
        ]
      }
    }
  }
}
